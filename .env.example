# Safe default: isolated preview. Values are placeholders, not credentials.
NEXT_PUBLIC_LMS_TARGET=preview
NEXT_PUBLIC_PREVIEW_SUPABASE_URL=https://YOUR_TEST_PROJECT.supabase.co
NEXT_PUBLIC_PREVIEW_SUPABASE_ANON_KEY=YOUR_TEST_PUBLISHABLE_KEY

# Production builds require NEXT_PUBLIC_LMS_TARGET=production and the existing
# production project's URL/publishable key. Do not put secret/service_role keys here.
# NEXT_PUBLIC_SUPABASE_URL=https://lmuwsjjrqmmmtmxjvqln.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PRODUCTION_PUBLISHABLE_KEY
